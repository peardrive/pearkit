{
  "name": "pearkit",
  "version": "0.2.0",
  "description": "Universal, themeable UI kit for PearDrive apps \u2014 one set of React components for React Native and Electron, styled with Tailwind (NativeWind).",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "./lib/typescript/commonjs/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./electron": {
      "import": {
        "types": "./lib/typescript/module/electron/index.d.ts",
        "default": "./lib/module/electron/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/electron/index.d.ts",
        "default": "./lib/commonjs/electron/index.js"
      }
    },
    "./tailwind-preset": "./tailwind.preset.js",
    "./vite": "./vite.js",
    "./global.css": "./global.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "src",
    "lib",
    "tailwind.preset.js",
    "global.css",
    "vite.js",
    "!**/*.stories.tsx",
    "!src/stories"
  ],
  "scripts": {
    "prepare": "bob build",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "icons": "node scripts/build-icons.mjs",
    "readme:header": "node scripts/capture-readme-header.mjs",
    "test": "vitest"
  },
  "peerDependencies": {
    "@vitejs/plugin-react": ">=4",
    "nativewind": ">=4.1.0 <5",
    "react": ">=18",
    "react-native": ">=0.76",
    "react-native-svg": ">=15",
    "react-native-web": ">=0.19",
    "tailwindcss": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "react-native-web": {
      "optional": true
    },
    "@vitejs/plugin-react": {
      "optional": true
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "qrcode-generator": "^1.5.2",
    "tailwind-merge": "^2.6.1"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "^7.27.1",
    "@chromatic-com/storybook": "latest",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/react-vite": "^10.6.5",
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "autoprefixer": "^10.6.2",
    "nativewind": "^4.2.7",
    "playwright": "latest",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-native": "^0.87.1",
    "react-native-builder-bob": "^0.43.2",
    "react-native-reanimated": "^4.7.1",
    "react-native-svg": "^15.16.0",
    "react-native-web": "^0.21.4",
    "storybook": "^10.6.5",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "latest"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "exclude": "**/{__tests__,__fixtures__,__mocks__,stories}/**",
    "targets": [
      [
        "commonjs",
        {
          "configFile": true,
          "esm": true
        }
      ],
      [
        "module",
        {
          "configFile": true,
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peardrive/pearkit.git"
  },
  "keywords": [
    "react-native",
    "electron",
    "react-native-web",
    "tailwind",
    "nativewind",
    "ui-kit",
    "design-system",
    "peardrive",
    "peardrop"
  ],
  "author": "PearDrive",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/peardrive/pearkit/issues"
  },
  "homepage": "https://github.com/peardrive/pearkit#readme"
}
