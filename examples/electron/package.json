{
  "name": "pearkit-example-electron",
  "private": true,
  "version": "0.0.0",
  "description": "Frameless Electron window rendering pearkit through react-native-web.",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && npm run electron:dev\"",
    "electron:dev": "tsc -p tsconfig.electron.json && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "start": "electron ."
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.1.0",
    "nativewind": "^4.2.7",
    "pearkit": "file:../..",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-native-svg": "^15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "latest",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wait-on": "^8.0.1"
  }
}
